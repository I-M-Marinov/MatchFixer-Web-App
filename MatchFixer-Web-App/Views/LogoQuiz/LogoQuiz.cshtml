@using MatchFixer.Core.ViewModels.LogoQuiz
@model LogoQuizQuestionViewModel

@{
	ViewData["Title"] = $"Logo Quiz Game";
}

<div class="background-profile"></div>
	
<div class="border-0 rounded-4 p-4 flex-fill">
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert success-message" id="success-message">
			@TempData["SuccessMessage"]
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert error-message" id="error-message">
			@TempData["ErrorMessage"]
		</div>
	}

</div>



<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 75vh;">

	<div class="quiz-card p-4" style="width: 100%; max-width: 600px; position: relative;">

		<!-- How to Play — icon + overlay panel, both absolutely positioned inside the card -->
		<div style="position: absolute; top: 30px; right: 33px; z-index: 20;">
			<button class="btn btn-link p-0 text-info"
			        type="button"
			        data-bs-toggle="collapse"
			        data-bs-target="#howToPlay"
			        aria-expanded="false"
			        title="How to Play"
			        style="outline: none; box-shadow: none; border: none;">
				<i class="bi bi-info-circle-fill fs-4"></i>
			</button>
		</div>

		<div class="collapse" id="howToPlay"
		     style="position: absolute; top: 0; left: 0; right: 0; z-index: 10; border-radius: inherit;">
			<div style="background: rgba(0,0,0,0.88); border-radius: 12px; padding: 20px 22px; color: #f0f0f0; font-size: 0.82rem;">
				<div style="font-size: 0.95rem; font-weight: 700; letter-spacing: 0.04em; margin-bottom: 14px; text-align: center; text-transform: uppercase; color: #ffd700;">
					⚽ How to Play
				</div>
				<div style="display: flex; flex-direction: column; gap: 10px;">
					<div style="display: flex; align-items: flex-start; gap: 10px;">
						<span style="font-size: 1rem; flex-shrink: 0;">🎯</span>
						<span>Identify the football club from its badge and pick the correct answer from 4 options.</span>
					</div>
					<div style="display: flex; align-items: flex-start; gap: 10px;">
						<span style="font-size: 1rem; flex-shrink: 0;">✅</span>
						<div>
							<strong style="color: #4ade80;">Correct answer</strong>
							<div style="margin-top: 4px; display: flex; gap: 6px; flex-wrap: wrap;">
								<span style="background: rgba(74,222,128,0.15); border: 1px solid #4ade80; border-radius: 6px; padding: 2px 8px;">score &lt; 500 → <strong>+1 pt</strong></span>
								<span style="background: rgba(74,222,128,0.15); border: 1px solid #4ade80; border-radius: 6px; padding: 2px 8px;">500–750 → <strong>+2 pts</strong></span>
								<span style="background: rgba(74,222,128,0.15); border: 1px solid #4ade80; border-radius: 6px; padding: 2px 8px;">750+ → <strong>+3 pts</strong></span>
							</div>
						</div>
					</div>
					<div style="display: flex; align-items: flex-start; gap: 10px;">
						<span style="font-size: 1rem; flex-shrink: 0;">❌</span>
						<div>
							<strong style="color: #f87171;">Wrong answer</strong>
							<div style="margin-top: 4px; display: flex; gap: 6px; flex-wrap: wrap;">
								<span style="background: rgba(248,113,113,0.15); border: 1px solid #f87171; border-radius: 6px; padding: 2px 8px;">score &lt; 500 → <strong>−50%</strong></span>
								<span style="background: rgba(248,113,113,0.15); border: 1px solid #f87171; border-radius: 6px; padding: 2px 8px;">500–750 → <strong>−30%</strong></span>
								<span style="background: rgba(248,113,113,0.15); border: 1px solid #f87171; border-radius: 6px; padding: 2px 8px;">750+ → <strong>−15%</strong></span>
							</div>
						</div>
					</div>
					<div style="display: flex; align-items: flex-start; gap: 10px;">
						<span style="font-size: 1rem; flex-shrink: 0;">⏭️</span>
						<span><strong style="color: #facc15;">Skipping</strong> without answering costs <strong>−1 pt</strong>. Advancing after you've already answered is always free.</span>
					</div>
				</div>
			</div>
		</div>

		<div class="logo-quiz-score d-flex flex-column justify-content-center align-items-center">
			<p>Your score: <span class="score-number">@Model.CurrentScore</span></p>
		</div>

		<div id="quiz-countdown">
			Next question in <span id="countdown-value">2</span> seconds...
		</div>

		<div class="card-body text-center">

			<h5 class="card-title mb-4">Guess whose is the logo below ?</h5>

			<div class="team-image-container text-center">
				<img src="@Model.LogoUrl" alt="Team Logo" class="img-fluid mb-4" style="max-height: 175px;"/>
			</div>

			<form method="post" asp-action="LogoQuiz">
				@Html.AntiForgeryToken()

				@foreach (var option in Model.OriginalOptions)
				{
					<input type="hidden" name="OriginalOptions" value="@option"/>
				}

				@foreach (var option in Model.Options)
				{
					string buttonClass = "btn mb-2 w-75 d-flex justify-content-center align-items-center";

					if (Model.IsCorrect.HasValue)
					{
						if (option == Model.CorrectAnswer)
							buttonClass += " btn-success w-75 mx-auto d-flex justify-content-center align-items-center";
						else if (option == Model.SelectedAnswer && option != Model.CorrectAnswer)
							buttonClass += " btn-danger w-75 mx-auto d-flex justify-content-center align-items-center";
						else
							buttonClass += " btn-gold w-75 mx-auto";
					}
					else
					{
						buttonClass += " btn-gold";
					}

					<button type="submit"
					        name="SelectedAnswer"
					        value="@option"
					        class="@buttonClass"
					        @(Model.IsCorrect.HasValue ? "disabled" : "")>
						<span>@option</span>

					</button>
				}

				<input type="hidden" name="CorrectAnswer" value="@Model.CorrectAnswer"/>
				<input type="hidden" name="LogoUrl" value="@Model.LogoUrl"/>
				<input type="hidden" name="SelectedAnswer" value="@Model.SelectedAnswer"/>

			</form>

			@if (Model.IsCorrect.HasValue)
			{
				<script>

					document.addEventListener("DOMContentLoaded", function () {
						const countdownContainer = document.getElementById("quiz-countdown");
						const countdownSpan = document.getElementById("countdown-value");

						if (countdownContainer) {
							countdownContainer.style.display = "block";
						}

						let secondsLeft = 2;
						const interval = setInterval(function () {
							secondsLeft--;
							if (countdownSpan) countdownSpan.textContent = secondsLeft;

							if (secondsLeft <= 0) {
								clearInterval(interval);
								document.getElementById('auto-next-form')?.submit();
							}
						}, 1000);
					});

				</script>
			}


		</div>

		<div class="mt-2 d-flex justify-content-center align-items-center" style="height: 50px;">

			@{
				bool canSkip = !Model.IsCorrect.HasValue && Model.CurrentScore > 0;
				bool isUnanswered = !Model.IsCorrect.HasValue;
			}
			<form method="get" asp-action="LogoQuiz" id="auto-next-form">
				<input type="hidden" name="currentScore" value="@Model.CurrentScore"/>
				@if (canSkip)
				{
					<input type="hidden" name="skip" value="true"/>
				}
				<button type="submit"
				        class="btn btn-primary px-4 guess-next-btn"
				        @(isUnanswered && !canSkip ? "disabled" : "")
				        title="@(isUnanswered && !canSkip ? "You need at least 1 point to skip" : "")">
					<i class="bi bi-arrow-right-circle-fill"></i> Guess Next
					@if (canSkip)
					{
						<span class="badge bg-danger ms-2" style="font-size: 0.7rem;">-1 pt</span>
					}
				</button>
			</form>

		</div>
	</div>
</div>
