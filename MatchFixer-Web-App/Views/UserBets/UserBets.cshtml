					// The wordmark text on top.
					const txt = document.createElement("div");
					txt.style.cssText = "position:relative;z-index:1;white-space:nowrap;line-height:1;" +
						"font-family:\'Archivo Black\',\'Arial Black\',sans-serif;" +
						"font-weight:400;font-size:34px;letter-spacing:0;";
					txt.innerHTML =
						'<span style="color:' + GREEN + ';text-shadow:' + SH_TRIPLE + '">M</span>' +
						'<span style="color:' + NAVY  + ';text-shadow:' + SH_SINGLE + '">atch</span>' +
						'<span style="color:' + GREEN + ';text-shadow:' + SH_TRIPLE + '">F</span>' +
						'<span style="color:' + NAVY  + ';text-shadow:' + SH_SINGLE + '">ixer</span>';

					brandLogo.appendChild(splat);
					brandLogo.appendChild(txt);
					clone.appendChild(brandLogo);

					// Football to the right of the amount box.
					const amountBox = clone.querySelector(".custom-card-user-bets");
					if (amountBox) {
						amountBox.style.position = "relative";
						const ball = document.createElement("div");
						ball.style.cssText = "position:absolute;top:50%;right:-122px;" +
							"transform:translateY(-50%) rotate(14deg);width:84px;height:84px;" +
							"filter:drop-shadow(3px 5px 5px rgba(0,0,0,.45));";
						ball.innerHTML = '<img src="/images/balls/soccer-ball2.svg" alt="" style="width:100%;height:100%;display:block;object-fit:contain">';
						amountBox.appendChild(ball);
					}

					holder.appendChild(clone);
					document.body.appendChild(holder);

					const blob = await htmlToImage.toBlob(clone, {
						pixelRatio: 2,
						cacheBust: true
					});
					if (!blob) throw new Error('No image blob produced.');

					const won = slip.classList.contains('slip-border-won');
					const fileName = 'MatchFixer-' + (won ? 'Win' : 'Betslip') + '-' + Date.now() + '.png';

					// Native share sheet on mobile, download everywhere else.
					const file = new File([blob], fileName, { type: 'image/png' });
					if (navigator.canShare && navigator.canShare({ files: [file] })) {
						try {
							await navigator.share({ files: [file], title: 'MatchFixer Betslip' });
						} catch (shareErr) { /* user dismissed the share sheet */ }
					} else {
						const url = URL.createObjectURL(blob);
						const a = document.createElement('a');
						a.href = url;
						a.download = fileName;
						document.body.appendChild(a);
						a.click();
						a.remove();
						setTimeout(() => URL.revokeObjectURL(url), 1000);
					}
				} catch (err) {
					console.error('Slip image failed:', err);
				} finally {
					if (holder && holder.parentNode) { holder.parentNode.removeChild(holder); }
					if (icon && prevIcon) { icon.className = prevIcon; }
					btn.classList.remove('is-busy');
					btn.disabled = false;
				}
			}

			document.getElementById('betSlipTabContent').addEventListener('click', function (e) {
				const shareBtn = e.target.closest('.slip-share-btn');
				if (!shareBtn) return;
				e.preventDefault();
				e.stopPropagation();
				shareSlip(shareBtn);
			});

			// Collapse any open slip when switching tabs.
			document.querySelectorAll('#betSlipTabs button[data-bs-toggle="tab"]').forEach(tab => {
				tab.addEventListener('hide.bs.tab', () => {
					document.querySelectorAll('.collapse.show').forEach(collapse => {
						bootstrap.Collapse.getInstance(collapse)?.hide();
					});
				});
			});
		});
	})();
</script>
