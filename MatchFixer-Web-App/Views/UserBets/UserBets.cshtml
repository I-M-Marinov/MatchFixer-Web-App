@model MatchFixer.Core.DTOs.Bets.PagedBetSlipsDTO

@{
	ViewData["Title"] = "My Betslips";
}

<div class="game-background"></div>

<div class="border-0 rounded-4 p-4 flex-fill">
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert success-message" id="success-message">
			@TempData["SuccessMessage"]
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert error-message" id="error-message">
			@TempData["ErrorMessage"]
		</div>
	}
</div>

<div class="card custom-card custom-betslip-card shadow-lg rounded-4 p-4">

	<ul class="nav nav-tabs mb-4" id="betSlipTabs" role="tablist">
		<li class="nav-item" role="presentation">
			<button class="nav-link active" id="pending-tab" data-bs-toggle="tab"
					data-bs-target="#pending" type="button" role="tab">
				Pending
			</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="won-tab" data-bs-toggle="tab"
					data-bs-target="#won" type="button" role="tab">
				Won
			</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="lost-tab" data-bs-toggle="tab"
					data-bs-target="#lost" type="button" role="tab">
				Lost
			</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="voided-tab" data-bs-toggle="tab"
					data-bs-target="#voided" type="button" role="tab">
				Voided
			</button>
		</li>
	</ul>

	<div class="tab-content" id="betSlipTabContent">

		<div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
			<div class="betslip-tab-body" data-status="Pending" data-loaded="true">
				@await Html.PartialAsync("_BetSlipList", Model)
			</div>
		</div>

		<div class="tab-pane fade" id="won" role="tabpanel" aria-labelledby="won-tab">
			<div class="betslip-tab-body" data-status="Won" data-loaded="false">
				<div class="betslip-loading text-center py-5"><span class="spinner-border text-light"></span></div>
			</div>
		</div>

		<div class="tab-pane fade" id="lost" role="tabpanel" aria-labelledby="lost-tab">
			<div class="betslip-tab-body" data-status="Lost" data-loaded="false">
				<div class="betslip-loading text-center py-5"><span class="spinner-border text-light"></span></div>
			</div>
		</div>

		<div class="tab-pane fade" id="voided" role="tabpanel" aria-labelledby="voided-tab">
			<div class="betslip-tab-body" data-status="Voided" data-loaded="false">
				<div class="betslip-loading text-center py-5"><span class="spinner-border text-light"></span></div>
			</div>
		</div>

	</div>
</div>

<!-- Slip -> PNG (share / download) -->
<script src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap">
<style>
	.slip-container { position: relative; }
	.slip-share-btn {
		position: absolute;
		bottom: .55rem;
		right: .6rem;
		z-index: 6;
		width: 2.1rem;
		height: 2.1rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: 50%;
		background: rgba(0, 0, 0, .55);
		color: #fff;
		box-shadow: 0 2px 6px rgba(0, 0, 0, .35);
		cursor: pointer;
		transition: transform .15s ease, background .15s ease;
	}
	.slip-share-btn { display: none; }
	.slip-container.slip-open .slip-share-btn { display: inline-flex; }
	.slip-share-btn:hover { background: #08ac93; transform: scale(1.08); }
	.slip-share-btn:disabled,
	.slip-share-btn.is-busy { opacity: .65; cursor: default; transform: none; }
	.slip-share-btn i { pointer-events: none; font-size: 1rem; }
</style>

<script>
	(function () {
		let currentPageSize = 15;

		// (Re)initialise tooltips + collapse behaviour for freshly rendered slips.
		function initSlipInteractions(container) {
			if (!container) return;

			container.querySelectorAll('[data-bs-toggle="tooltip"]')
				.forEach(el => new bootstrap.Tooltip(el));

			container.querySelectorAll('.collapse').forEach(collapse => {
				const enclosure = collapse.closest('.slip-enclosure');
				const slipCard = collapse.closest('.slip-container');
				collapse.addEventListener('shown.bs.collapse', () => {
					enclosure?.classList.add('open');
					slipCard?.classList.add('slip-open');
				});
				collapse.addEventListener('hidden.bs.collapse', () => {
					enclosure?.classList.remove('open');
					slipCard?.classList.remove('slip-open');
				});
			});
		}

		async function loadPane(body, page, pageSize) {
			if (!body) return;
			const status = body.dataset.status;

			body.innerHTML = '<div class="betslip-loading text-center py-5"><span class="spinner-border text-light"></span></div>';

			try {
				const res = await fetch(`/UserBets/Slips?status=${encodeURIComponent(status)}&page=${page}&pageSize=${pageSize}`);
				body.innerHTML = await res.text();
				body.dataset.loaded = "true";
				initSlipInteractions(body);
			} catch (err) {
				body.innerHTML = '<div class="alert-custom-info-wrapper"><div class="alert-custom-info">Could not load bet slips. Please try again.</div></div>';
			}
		}

		document.addEventListener('DOMContentLoaded', function () {
			// Pending is server-rendered — just wire up its interactions.
			initSlipInteractions(document.querySelector('.betslip-tab-body[data-status="Pending"]'));

			// Lazy-load a tab the first time it is shown.
			document.querySelectorAll('#betSlipTabs button[data-bs-toggle="tab"]').forEach(tabBtn => {
				tabBtn.addEventListener('shown.bs.tab', function (e) {
					const paneId = e.target.getAttribute('data-bs-target');
					const body = document.querySelector(`${paneId} .betslip-tab-body`);
					if (body && body.dataset.loaded === "false") {
						loadPane(body, 1, currentPageSize);
					}
				});
			});

			// Page number clicks.
			document.getElementById('betSlipTabContent').addEventListener('click', function (e) {
				const btn = e.target.closest('.betslip-pagination button[data-page]');
				if (!btn || btn.closest('.page-item')?.classList.contains('disabled')) return;

				const body = btn.closest('.betslip-tab-body');
				const page = parseInt(btn.dataset.page, 10);
				if (isNaN(page) || page < 1) return;

				loadPane(body, page, currentPageSize);
			});

			// Page-size dropdown changes.
			document.getElementById('betSlipTabContent').addEventListener('change', function (e) {
				const select = e.target.closest('.betslip-page-size-select');
				if (!select) return;

				currentPageSize = parseInt(select.value, 10) || 15;
				const body = select.closest('.betslip-tab-body');
				loadPane(body, 1, currentPageSize);
			});

			// Icon fonts don't rasterise (their glyphs live in ::before), so for the
			// captured image only we swap each <i> for an equivalent inline SVG.
			function iconSvgFor(cls) {
				const mr = cls.indexOf('me-1') >= 0;
				// Padded viewBox + a little extra size so edge-touching circles are never clipped in the cell.
				const wrap = inner =>
					'<svg viewBox="-1.6 -1.6 19.2 19.2" xmlns="http://www.w3.org/2000/svg" ' +
					'style="width:1.15em;height:1.15em;vertical-align:middle;display:inline-block;overflow:visible' +
					(mr ? ';margin-right:.3em' : '') + '">' + inner + '</svg>';

				if (cls.indexOf('ri-checkbox-circle') >= 0)   // outcome: won (green tick)
					return wrap('<circle cx="8" cy="8" r="8" fill="#056301"/><path d="M4.6 8.4l2.1 2.1 4.7-4.9" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>');
				if (cls.indexOf('ri-close-circle') >= 0)      // outcome: lost (red X)
					return wrap('<circle cx="8" cy="8" r="8" fill="#dc3545"/><path d="M5.5 5.5l5 5M10.5 5.5l-5 5" stroke="#fff" stroke-width="1.7" stroke-linecap="round"/>');
				if (cls.indexOf('bi-question-circle') >= 0)   // outcome: pending (?) - Bootstrap question-circle, orange
					return wrap('<g fill="#ff6a00"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm2.325 6.443c.61 0 1.029-.394 1.029-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94 0 .533.425.927 1.01.927z"/></g>');
				if (cls.indexOf('bi-slash-circle') >= 0)      // outcome/void
					return wrap('<circle cx="8" cy="8" r="7.3" fill="none" stroke="#6c757d" stroke-width="1.3"/><path d="M4 12L12 4" stroke="#6c757d" stroke-width="1.3" stroke-linecap="round"/>');
				if (cls.indexOf('bi-lightning') >= 0)         // total odds (bolt)
					return wrap('<path d="M9.7 1.2 3.6 9.1c-.2.3 0 .6.4.6h2.6l-1 4.9c-.1.5.5.8.8.4l5.9-7.8c.2-.3 0-.6-.4-.6H9.3l1-5c.1-.5-.5-.8-.6-.4z" fill="#ffc107" stroke="#e0a800" stroke-width=".4" stroke-linejoin="round"/>');
				if (cls.indexOf('bi-clock') >= 0)             // pending header
					return wrap('<circle cx="8" cy="8" r="7" fill="none" stroke="#ffe08a" stroke-width="1.3"/><path d="M8 4.3V8l2.5 1.6" fill="none" stroke="#ffe08a" stroke-width="1.3" stroke-linecap="round"/>');
				if (cls.indexOf('bi-check-circle') >= 0)      // won header (on green bg)
					return wrap('<circle cx="8" cy="8" r="7.1" fill="none" stroke="#fff" stroke-width="1.3"/><path d="M4.8 8.3l2.1 2.1 4.5-4.7" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>');
				if (cls.indexOf('bi-x-circle') >= 0)          // lost header
					return wrap('<circle cx="8" cy="8" r="7.1" fill="none" stroke="#ff6b6b" stroke-width="1.3"/><path d="M5.6 5.6l4.8 4.8M10.4 5.6l-4.8 4.8" stroke="#ff6b6b" stroke-width="1.4" stroke-linecap="round"/>');
				return null;
			}

			function replaceIconsWithSvg(root) {
				root.querySelectorAll('i').forEach(iEl => {
					const svg = iconSvgFor(iEl.className || '');
					if (!svg) return;
					const tpl = document.createElement('span');
					tpl.innerHTML = svg;
					const node = tpl.firstElementChild;
					if (node) iEl.replaceWith(node);
				});
			}

			// --- Share / download a slip as a PNG image ---------------------
			async function shareSlip(btn) {
				if (typeof htmlToImage === 'undefined') return;
				const slip = btn.closest('.slip-container');
				if (!slip) return;

				const icon = btn.querySelector('i');
				const prevIcon = icon ? icon.className : null;
				btn.classList.add('is-busy');
				btn.disabled = true;
				if (icon) icon.className = 'bi bi-hourglass-split';

				let holder = null;
				try {
					if (document.fonts) {
						try { await document.fonts.load("44px 'Archivo Black'"); } catch (e) { }
						if (document.fonts.ready) { await document.fonts.ready; }
					}

					// Render an off-screen, fully-expanded clone so the whole slip is captured.
					const rect = slip.getBoundingClientRect();
					holder = document.createElement('div');
					holder.style.cssText =
						'position:fixed;top:0;left:-100000px;z-index:-1;pointer-events:none;width:' +
						Math.ceil(rect.width) + 'px;';

					const clone = slip.cloneNode(true);
					clone.style.margin = '0';
					clone.querySelectorAll('.collapse').forEach(c => {
						c.classList.add('show');
						c.style.height = 'auto';
						c.style.display = 'block';
					});
					// Keep the image clean: drop button, slip number, date, breakdown heading and the events badge.
					clone.querySelectorAll('.slip-share-btn, .betslip-slip-number, .betslip-submitted, .betslip-breakdown-title, .betslip-events-badge').forEach(el => el.remove());
					replaceIconsWithSvg(clone);

					// Branding for the shared image only: tilted MatchFixer wordmark with a cream splat behind it.
					const GREEN = "#10b981", NAVY = "#1e3a8a";
					const SH_TRIPLE = "3px 3px 0 #1e3a8a, 6px 6px 0 #000"; // M & F: navy + black (two colours)
					const SH_SINGLE = "3px 3px 0 #000";                                 // all other letters
					const brandLogo = document.createElement("div");
					brandLogo.style.cssText = "position:absolute;top:90px;left:8px;z-index:8;" +
						"display:inline-block;transform:rotate(-13deg);transform-origin:center;";

					// Irregular cream splat behind the text (~42% opacity of the reference background colour).
					const splat = document.createElement("div");
					splat.style.cssText = "position:absolute;inset:-30px -46px;z-index:0;opacity:1;pointer-events:none;filter:drop-shadow(2px 4px 3px rgba(0,0,0,.5));";
