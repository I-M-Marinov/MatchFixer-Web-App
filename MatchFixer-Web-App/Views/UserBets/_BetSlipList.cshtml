@using MatchFixer.Common.Enums
@model MatchFixer.Core.DTOs.Bets.PagedBetSlipsDTO

@{
	var currentTab = Model.Status;
	decimal summaryAmount = Model.SummaryAmount;

	string summaryTitle = currentTab switch
	{
		"Pending" => "Total Potential Win",
		"Won" => "Total Won",
		"Lost" => "Total Lost",
		"Voided" => "Total Refunded",
		_ => "Summary"
	};

	string summaryClass = currentTab switch
	{
		"Pending" => "bg-warning text-dark pending-betslips potential-wins-summary",
		"Won" => "bg-success text-dark won-betslips wins-summary",
		"Lost" => "bg-danger text-white lost-betslips lost-summary",
		_ => "bg-secondary text-dark"
	};

	string pagerBadgeClass = currentTab switch
	{
		"Pending" => "status-pending",
		"Won" => "status-won",
		"Lost" => "status-lost",
		"Voided" => "status-void",
		_ => "status-pending"
	};

	int windowSize = 5;
	int startPage = Math.Max(1, Model.Page - windowSize / 2);
	int endPage = Math.Min(Model.TotalPages, startPage + windowSize - 1);
	startPage = Math.Max(1, endPage - windowSize + 1);
}

@if (Model.TotalCount == 0)
{
	<div class="alert-custom-info-wrapper">
		<div class="alert-custom-info">No bet slips in this category right now.</div>
	</div>
}
else
{
	<!-- Pager — sits between the tab strip and the first slip -->
	<div class="betslip-pager d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"
		 data-status="@Model.Status">

		<div class="betslip-pager-size d-flex align-items-center gap-2">
			<span>Show</span>
			<select class="betslip-page-size-select form-select form-select-sm" aria-label="Slips per page">
				@foreach (var size in new[] { 15, 25, 50 })
				{
					if (Model.PageSize == size)
					{
						<option value="@size" selected>@size</option>
					}
					else
					{
						<option value="@size">@size</option>
					}
				}
			</select>
			<span>per page</span>
		</div>

		@if (Model.TotalPages > 1)
		{
			<ul class="pagination pagination-sm betslip-pagination mb-0">
				<li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
					<button type="button" class="page-link" data-page="@(Model.Page - 1)" aria-label="Previous">&lsaquo;</button>
				</li>
				@for (int p = startPage; p <= endPage; p++)
				{
					<li class="page-item @(p == Model.Page ? "active" : "")">
						<button type="button" class="page-link" data-page="@p">@p</button>
					</li>
				}
				<li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
					<button type="button" class="page-link" data-page="@(Model.Page + 1)" aria-label="Next">&rsaquo;</button>
				</li>
			</ul>
		}

		<span class="betslip-events-badge @pagerBadgeClass">
			@Model.TotalCount slip@(Model.TotalCount == 1 ? "" : "s")
		</span>
	</div>

	<div class="row">
		<!-- Left Betslips Column -->
		<div class="col-md-8 betslips-col">
			<div class="d-flex flex-column gap-3">
				@for (int i = 0; i < Model.Slips.Count; i++)
				{
					var betSlip = Model.Slips[i];
					var collapseId = $"collapseBetslip{Model.Status}{i}";
					var eventsCount = betSlip.Bets?.Count ?? 0;

					var statusClass = betSlip.Status switch
					{
						"Won" => "bg-success",
						"Lost" => "bg-danger",
						"Pending" => "bg-warning text-dark",
						_ => "bg-secondary"
					};

					var borderClass = betSlip.Status switch
					{
						"Won"     => "slip-border-won",
						"Lost"    => "slip-border-lost",
						"Pending" => "slip-border-pending",
						"Voided"  => "slip-border-void",
						_         => ""
					};

					var badgeClass = betSlip.Status switch
					{
						"Pending" => "status-pending",
						"Won" => "status-won",
						"Lost" => "status-lost",
						"Voided" => "status-void",
						_ => "status-pending"
					};

					<div class="card shadow-sm slip-container @borderClass">

						<div class="slip-enclosure">

							<!-- Header -->
							<div class="card-header card-header-bet-totals @statusClass d-flex justify-content-between align-items-center"
								 data-bs-toggle="collapse" data-bs-target="#@collapseId"
								 title="Click to view betslip details" data-bs-placement="top"
								 style="cursor: pointer;">
								<div class="w-100 d-flex align-items-center">
									<div class="flex-grow-1"></div>
									<div class="text-center">
										@if (betSlip.Status == nameof(BetStatus.Won))
										{
											<span class="text-white">
												<i class="bi bi-check-circle me-1 text-white"></i>
												<strong>Won:</strong> €@(betSlip.WinAmount?.ToString("0.00") ?? "0.00")
											</span>
										}
										else if (betSlip.Status == nameof(BetStatus.Lost))
										{
											<span class="text-white">
												<i class="bi bi-x-circle me-1 text-tomato"></i>
												<strong>Lost:</strong> €@betSlip.Amount.ToString("0.00")
											</span>
										}
										else if (betSlip.Status == nameof(BetStatus.Pending))
										{
											var potentialWin = Math.Floor(betSlip.Amount * betSlip.TotalOdds * 100) / 100;
											<span class="text-black text-white">
												<i class="bi bi-clock me-1 text-yellow"></i>
												<strong>Potential Win:</strong> €@potentialWin.ToString("0.00")
											</span>
										}
										else // nameof(BetStatus.Void)
										{
											<span class="text-black">
												<i class="bi bi-slash-circle me-1"></i>
												@betSlip.Status
											</span>
										}
									</div>

									<!-- Event count -->
									<div class="flex-grow-1 text-end pe-2">
										<span class="betslip-events-badge @badgeClass">
											@eventsCount event@(eventsCount == 1 ? "" : "s")
										</span>
									</div>

								</div>

							</div>

							<!-- Body -->
							<div id="@collapseId" class="collapse">
								<div class="card-body d-flex flex-column align-items-center fuzzy-points">
									<div class="betslip-slip-number">
										<i class="bi bi-receipt me-1"></i>Slip #@betSlip.Id
									</div>
									<div class="custom-card-user-bets text-center">
										<p><strong>Amount:</strong> €@betSlip.Amount.ToString("F2")</p>
										<p>
											<strong>Total Odds:</strong>
											<i class="bi bi-lightning-charge-fill lightning-icon-all-odds" style="text-shadow: 1px 2px 3px #0dab76;"></i>
											@betSlip.TotalOdds.ToString("F2")x
										</p>
										<p>
											@{
												var displayedAmount = betSlip.WinAmount.HasValue
												? Math.Floor(betSlip.WinAmount.Value * 100) / 100
												: Math.Floor(betSlip.Amount * betSlip.TotalOdds * 100) / 100;
											}
											<strong>@(betSlip.Status == "Won" ? "Won:" : "Potential Win:")</strong>
											€@displayedAmount.ToString("0.00")
										</p>
									</div>

									<div class="betslip-submitted">
										<p class="small">
											<i class="bi bi-calendar-check me-1"></i>
											@betSlip.DisplayTime
										</p>
									</div>

									@if (betSlip.Bets != null && betSlip.Bets.Any())
									{
										<h6 class="mt-3 text-black"
											style="text-shadow:
													0 1px 0 rgba(255,255,255,0.9),
													0 -1px 0 rgba(255,255,255,0.9),
													1px 0 0 rgba(255,255,255,0.9),
													-1px 0 0 rgba(255,255,255,0.9);">
											Bets Breakdown
										</h6>
										<div class="table-responsive user-bets-table">
											<table class="table table-sm table-bordered text-center">
												<thead class="table-light">
													<tr>
														<th>Event</th>
														<th>Pick</th>
														<th>Odds</th>
														<th>Outcome</th>
													</tr>
												</thead>
												<tbody>
													@foreach (var bet in betSlip.Bets)
													{
														<tr>
															<td>@bet.HomeTeam <strong>vs</strong> @bet.AwayTeam</td>
															<td>
																@{
																	string pickClass = bet.SelectedOption switch
																	{
																		"Home" => "pill-brand-blue",
																		"Away" => "pill-brand-green",
																		_ => "pill-brand-yellow"
																	};
																}
																<span class="@pickClass" style="font-size: 0.65rem;">@bet.SelectedOption</span>
															</td>
															<td>@bet.Odds.ToString("F2")x</td>
															<td>
																@switch (bet.Status)
																{
																	case "Won":
																		<i class="ri-checkbox-circle-fill"
																		   style="color:#056301;"
																		   title="Bet is won"></i>
																		break;

																	case "Lost":
																		<i class="ri-close-circle-fill"
																		   style="color:#dc3545;"
																		   title="Bet is lost"></i>
																		break;

																	case "Voided":
																		<i class="bi bi-slash-circle"
																		   style="color:#6c757d;"
																		   title="Bet was voided"></i>
																		break;

																	default: // Pending
																		<i class="bi bi-question-circle"
																		   style="color:#ff6a00;"
																		   title="Bet is pending"></i>
																		break;
																}

																@(bet.Status == "Pending" ? "" : bet.Outcome)

															</td>

														</tr>
													}
												</tbody>
											</table>
										</div>
									}
								</div>
							</div>
						</div>


					</div>
				}
			</div>
		</div>
		<!-- Right Summary Column -->
		<div class="col-md-4 mb-4 summary-col">
			<div class="card shadow-sm @summaryClass">
				<div class="card-body d-flex flex-column justify-content-center align-items-center" style="min-height: 120px;">
					<h5 class="card-title">@summaryTitle</h5>
					<h2 class="fw-bold @summaryClass">€@summaryAmount.ToString("0.00")</h2>
				</div>
			</div>
		</div>
	</div>
}
