	/* ===== Responsive ===== */
	@@media (min-width:1101px) {
		/* Sticky inside the content column — never floats into the right gutter,
		   which belongs to the global bet slip. z-index stays below the slip (1050)
		   so an opened bet slip always covers the rail instead of the rail poking through. */
		.create-rail { position:sticky; top:80px; align-self:start; max-height:calc(100vh - 96px); overflow:auto; z-index:500; }
		.create-rail::-webkit-scrollbar { width:8px; }
		.create-rail::-webkit-scrollbar-thumb { background:rgba(148,163,184,.3); border-radius:8px; }
		#railToggle { display:none; }
	}
	@@media (max-width:1100px) {
		.tourney-layout { grid-template-columns:1fr; }
