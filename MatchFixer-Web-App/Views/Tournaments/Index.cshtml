@using MatchFixer.Common.Enums
@model MatchFixer.Core.ViewModels.Tournaments.TournamentListViewModel
@{
	ViewData["Title"] = "Tournaments";
	string Money(decimal v) => "€" + v.ToString("0.##");
}

<div class="background-profile"></div>

<div class="tourney-page">

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success tourney-alert">@TempData["SuccessMessage"]</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger tourney-alert">@TempData["ErrorMessage"]</div>
	}

	<!-- ===== Header ===== -->
	<div class="tourney-hero">
		<div class="hero-left">
			<div class="hero-eyebrow"><i class="bi bi-trophy-fill"></i> Play-money tournaments</div>
			<h1 class="hero-title">Tournaments</h1>
			<p class="hero-sub">Join a tournament, get a fresh <strong>@Money(1000) chip</strong> bankroll, and climb the board. Top finishers split a real prize pool — no deposit at risk, just bragging rights and the payout.</p>
		</div>
		<div class="hero-actions">
			<button type="button" class="hero-btn ghost" data-bs-toggle="modal" data-bs-target="#rulesModal">
				<i class="bi bi-info-circle"></i> How it works
			</button>
			<button type="button" class="hero-btn solid" id="railToggle">
				<i class="bi bi-plus-circle"></i> Create
			</button>
		</div>
	</div>

	<div class="tourney-layout">

		<!-- ===== Main column ===== -->
		<div class="tourney-main">

			<!-- The Pot -->
			@if (Model.Pots.Any())
			{
				<div class="pot-section">
					<div class="pot-head">
						<span class="pot-head-title"><i class="bi bi-coin"></i> The Pot</span>
						<span class="pot-head-sub">Special house-funded events — free to enter, top 3 split the prize.</span>
					</div>
					<div class="tourney-grid">
						@foreach (var t in Model.Pots) { @await Html.PartialAsync("_TournamentCard", t) }
					</div>
				</div>
			}

			<div class="tourney-panel">

				<!-- Tabs -->
				<div class="t-tabs" id="tourneyTabs" role="tablist">
					<button type="button" class="t-tab" data-tab="running" data-count="@Model.Running.Count">
						<span class="dot live"></span> Running <span class="t-count">@Model.Running.Count</span>
					</button>
					<button type="button" class="t-tab" data-tab="upcoming" data-count="@Model.Upcoming.Count">
						<span class="dot soon"></span> Upcoming <span class="t-count">@Model.Upcoming.Count</span>
					</button>
					<button type="button" class="t-tab" data-tab="finished" data-count="@Model.Finished.Count">
						<span class="dot done"></span> Finished <span class="t-count">@Model.Finished.Count</span>
					</button>
					@if (Model.Cancelled.Any())
					{
						<button type="button" class="t-tab" data-tab="cancelled" data-count="@Model.Cancelled.Count">
							<span class="dot cancel"></span> Cancelled <span class="t-count">@Model.Cancelled.Count</span>
						</button>
					}
					<button type="button" class="t-tab t-tab-lb" data-tab="leaderboard" data-count="@Model.Leaderboard.Count">
						<i class="bi bi-bar-chart-steps"></i> Hall of Fame
					</button>
				</div>

				<div class="t-panels">

					<div class="t-panel" data-panel="running">
						@if (Model.Running.Any())
						{
							<div class="tourney-grid">
								@foreach (var t in Model.Running) { @await Html.PartialAsync("_TournamentCard", t) }
							</div>
						}
						else { <div class="t-empty"><i class="bi bi-hourglass-split"></i> Nothing running right now.</div> }
					</div>

					<div class="t-panel" data-panel="upcoming">
						@if (Model.Upcoming.Any())
						{
							<div class="tourney-grid">
								@foreach (var t in Model.Upcoming) { @await Html.PartialAsync("_TournamentCard", t) }
							</div>
						}
						else { <div class="t-empty"><i class="bi bi-calendar-plus"></i> No upcoming tournaments — create one!</div> }
					</div>

					<div class="t-panel" data-panel="finished">
						@if (Model.Finished.Any())
						{
							<div class="tourney-grid">
								@foreach (var t in Model.Finished) { @await Html.PartialAsync("_TournamentCard", t) }
							</div>
						}
						else { <div class="t-empty"><i class="bi bi-flag"></i> No finished tournaments yet.</div> }
					</div>

					@if (Model.Cancelled.Any())
					{
						<div class="t-panel" data-panel="cancelled">
							<div class="tourney-grid">
								@foreach (var t in Model.Cancelled) { @await Html.PartialAsync("_TournamentCard", t) }
							</div>
						</div>
					}

					<div class="t-panel" data-panel="leaderboard">
						<div class="lb-card">
							<h3 class="section-h"><i class="bi bi-bar-chart-steps"></i> Hall of Fame — all-time tournament prizes</h3>
							@if (Model.Leaderboard.Any())
							{
								<div class="table-responsive">
									<table class="lb-table">
										<thead>
											<tr>
												<th class="lb-rank-h">#</th>
												<th class="ta-l">Player</th>
												<th>Prize won</th>
												<th>Wins</th>
												<th>Podiums</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var r in Model.Leaderboard)
											{
												<tr class="@(r.IsCurrentUser ? "me" : "")">
													<td class="lb-rank">
														@if (r.Rank == 1) { <i class="bi bi-trophy-fill gold"></i> }
														else if (r.Rank == 2) { <i class="bi bi-trophy-fill silver"></i> }
														else if (r.Rank == 3) { <i class="bi bi-trophy-fill bronze"></i> }
														else { <span>@r.Rank</span> }
													</td>
													<td class="ta-l">
														<span class="lb-player">
															<img src="@r.Picture" alt="" class="lb-avatar" onerror="this.onerror=null;this.src='/images/default-user-image.png'" />
															<span class="lb-name">@r.UserName</span>
															@if (r.IsCurrentUser) { <span class="you-tag">you</span> }
														</span>
													</td>
													<td class="lb-prize">€@r.TotalPrize.ToString("0.##")</td>
													<td class="lb-num">@(r.Wins > 0 ? r.Wins.ToString() : "—")</td>
													<td class="lb-num">@(r.Podiums > 0 ? r.Podiums.ToString() : "—")</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
							else
							{
								<div class="t-empty inner"><i class="bi bi-trophy"></i> No finished tournaments yet — the hall of fame is waiting for its first champion.</div>
							}
						</div>
					</div>

				</div>
			</div>
		</div>

		<!-- ===== Create rail (sticky / floats on wide screens) ===== -->
		<aside class="create-rail" id="createRail">
			<div class="create-float" id="railAccordion">

				<!-- Create tournament -->
				<div class="rail-card">
					<div class="rail-card-head" data-bs-toggle="collapse" data-bs-target="#railCreate" role="button" aria-expanded="true">
						<span><i class="bi bi-trophy"></i> Create a tournament</span>
						<i class="bi bi-chevron-down rc-chev"></i>
					</div>
					<div class="collapse show" id="railCreate" data-bs-parent="#railAccordion">
						<form asp-action="Create" method="post" class="rail-form">
							<div class="fld">
								<label>Name</label>
								<input name="Name" class="form-control form-control-sm" maxlength="100" required placeholder="Friday Night Cup" />
							</div>
							<div class="fld">
								<label>Description <span class="muted">(optional)</span></label>
								<input name="Description" class="form-control form-control-sm" maxlength="1000" placeholder="Anyone welcome. Good luck!" />
							</div>
							<div class="fld">
								<label>Entry fee (€)</label>
								<input name="EntryFee" type="number" step="0.01" min="0" value="10" class="form-control form-control-sm" required />
							</div>
							<div class="fld">
								<label>Starts</label>
								<input name="StartDate" type="datetime-local" value="@Model.CreateForm.StartDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" required />
							</div>
							<div class="fld">
								<label>Ends</label>
								<input name="EndDate" type="datetime-local" value="@Model.CreateForm.EndDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" required />
							</div>
							<div class="fld-2">
								<div class="fld">
									<label>Min entrants</label>
									<input name="MinEntrantsToRun" type="number" min="2" value="2" class="form-control form-control-sm" required />
								</div>
								<div class="fld">
									<label>Max <span class="muted">(opt.)</span></label>
									<input name="MaxEntrants" type="number" min="2" class="form-control form-control-sm" placeholder="∞" />
								</div>
							</div>
							<div class="fld">
								<label>Min matches per bet</label>
								<input name="MinBetLegs" type="number" min="1" max="12" value="1" class="form-control form-control-sm" required />
								<span class="muted tiny">1 = singles · 2+ forces parlays</span>
							</div>
							<div class="rail-note">
								<i class="bi bi-clock-history"></i> Times are in your local zone (@Model.UserTimeZoneLabel). House keeps 10% rake. You're entered automatically.
							</div>
							<button type="submit" class="btn btn-mint w-100"><i class="bi bi-check2-circle"></i> Create &amp; join</button>
						</form>
					</div>
				</div>

				@if (Model.IsAdmin)
				{
					<!-- Create The Pot (admin) -->
					<div class="rail-card rail-card-pot">
						<div class="rail-card-head" data-bs-toggle="collapse" data-bs-target="#railPot" role="button" aria-expanded="false">
							<span><i class="bi bi-coin"></i> Create The Pot <span class="admin-tag">admin</span></span>
							<i class="bi bi-chevron-down rc-chev"></i>
						</div>
						<div class="collapse" id="railPot" data-bs-parent="#railAccordion">
							<div class="rake-guide">
								<div class="rake-row"><span>Rake collected</span><span>@Money(Model.TotalRakeCollected)</span></div>
								<div class="rake-row"><span>Already in Pots</span><span>−@Money(Model.RakeAllocatedToPots)</span></div>
								<div class="rake-row total"><span>Available to seed</span><span>@Money(Model.AvailableRake)</span></div>
							</div>
							<form asp-action="CreatePot" method="post" class="rail-form">
								<div class="fld">
									<label>Pot name</label>
									<input name="Name" class="form-control form-control-sm" maxlength="100" required value="The Pot" />
								</div>
								<div class="fld">
									<label>Description <span class="muted">(optional)</span></label>
									<input name="Description" class="form-control form-control-sm" maxlength="1000" placeholder="Biggest pot of the month!" />
								</div>
								<div class="fld">
									<label>Prize pool (€)</label>
									<input name="PrizePool" type="number" step="0.01" min="1" value="@Model.CreatePotForm.PrizePool.ToString("0.##")" class="form-control form-control-sm" required />
									<span class="muted tiny">Seed from the rake above, or set any amount.</span>
								</div>
								<div class="fld">
									<label>Duration</label>
									<select name="DurationWeeks" class="form-select form-select-sm">
										<option value="2">2 weeks</option>
										<option value="4">4 weeks</option>
										<option value="6">6 weeks</option>
									</select>
								</div>
								<div class="fld">
									<label>Top-3 split (%)</label>
									<div class="split-row">
										<input name="FirstPct" type="number" step="1" min="0" max="100" value="60" class="form-control form-control-sm" title="1st %" />
										<input name="SecondPct" type="number" step="1" min="0" max="100" value="30" class="form-control form-control-sm" title="2nd %" />
										<input name="ThirdPct" type="number" step="1" min="0" max="100" value="10" class="form-control form-control-sm" title="3rd %" />
									</div>
									<span class="muted tiny">1st · 2nd · 3rd</span>
								</div>
								<div class="fld-2">
									<div class="fld">
										<label>Min entrants</label>
										<input name="MinEntrantsToRun" type="number" min="1" value="3" class="form-control form-control-sm" required />
									</div>
									<div class="fld">
										<label>Bankroll</label>
										<input name="StartingBankroll" type="number" min="1" value="1000" class="form-control form-control-sm" required />
									</div>
								</div>
								<div class="fld">
									<label>Min matches per bet</label>
									<input name="MinBetLegs" type="number" min="1" max="12" value="1" class="form-control form-control-sm" required />
								</div>
								<div class="rail-note pot">
									<i class="bi bi-stars"></i> Free to enter. Starts now, runs the chosen weeks, then the top 3 split the prize.
								</div>
								<button type="submit" class="btn btn-gold w-100"><i class="bi bi-coin"></i> Launch The Pot</button>
							</form>
						</div>
					</div>
				}

			</div>
		</aside>

	</div>
</div>

<!-- ===== Rules modal ===== -->
<div class="modal fade" id="rulesModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
		<div class="modal-content rules-modal">
			<div class="modal-header">
				<h5 class="modal-title"><i class="bi bi-info-circle"></i> How tournaments work</h5>
				<button type="button" class="rules-close" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
			</div>
			<div class="modal-body">
				<div class="rule-block">
					<div class="rule-icon"><i class="bi bi-box-arrow-in-right"></i></div>
					<div>
						<h6>Join &amp; get a bankroll</h6>
						<p>Pay the entry fee (real money, from your wallet) and you're in with a fresh <strong>1000-chip</strong> play-money bankroll. Chips are for ranking only — they're never cashed out.</p>
					</div>
				</div>
				<div class="rule-block">
					<div class="rule-icon"><i class="bi bi-cash-stack"></i></div>
					<div>
						<h6>Bet your chips</h6>
						<p>While a tournament is running, spend your chips on upcoming matches. Some tournaments require parlays (a minimum number of matches per bet). Winning bets grow your bankroll; the leaderboard ranks everyone by chips.</p>
					</div>
				</div>
				<div class="rule-block">
					<div class="rule-icon"><i class="bi bi-trophy"></i></div>
					<div>
						<h6>Prize pool &amp; payouts</h6>
						<p>All entry fees form the prize pool. The house keeps a <strong>10% rake</strong>; the rest is paid in real money. With 4+ players the top 3 split <strong>60 / 30 / 10</strong>; with 2–3 players the top 2 split <strong>70 / 30</strong>.</p>
					</div>
				</div>
				<div class="rule-block">
					<div class="rule-icon"><i class="bi bi-coin"></i></div>
					<div>
						<h6>The Pot</h6>
						<p>The Pot is a special, <strong>free-to-enter</strong> event funded by the house. It plays just like a normal tournament, runs for 2, 4 or 6 weeks, and the <strong>top 3 split the prize</strong> by the posted split. Jump in — there's nothing to pay.</p>
					</div>
				</div>
				<div class="rule-block">
					<div class="rule-icon"><i class="bi bi-shield-lock"></i></div>
					<div>
						<h6>Who sees what</h6>
						<p>Everyone can see a tournament's standings (the <em>positions</em>). Only players who've joined can see other players' <strong>bankrolls</strong> and the <strong>tournament board</strong>. Jump in to unlock the full picture and the trash talk.</p>
					</div>
				</div>
				<div class="rule-block">
					<div class="rule-icon"><i class="bi bi-arrow-counterclockwise"></i></div>
					<div>
						<h6>If it doesn't fill</h6>
						<p>If a tournament doesn't reach its minimum number of players by the end, it's cancelled and <strong>every entry fee is refunded</strong> automatically. Any bets still pending at settlement are voided and the chips returned.</p>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-mint" data-bs-dismiss="modal">Got it</button>
			</div>
		</div>
	</div>
</div>

<style>
	/* Break out of the Bootstrap .container so the panel gets real width even with the rail. */
	.tourney-page { position:relative; left:50%; transform:translateX(-50%); width:96vw; max-width:1480px; padding:16px 16px 64px; }
	.tourney-alert { border-radius:10px; }
	.muted { color:#94a3b8; font-weight:400; }
	.tiny { font-size:.72rem; display:block; margin-top:3px; }
	.ta-l { text-align:left; }
	.section-h { color:#e2e8f0; font-size:1.05rem; margin:0 0 14px; display:flex; align-items:center; gap:8px; font-weight:700; }
	.section-h i { color:#2ee59d; }

	/* ===== Header hero ===== */
	.tourney-hero { background:linear-gradient(135deg,#0f172a 0%,#132a3e 100%); border:1px solid rgba(148,163,184,.16); border-top:3px solid #2ee59d; border-radius:16px; padding:22px 24px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap; box-shadow:0 12px 30px rgba(0,0,0,.35); }
	.hero-eyebrow { font-size:.72rem; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:#2ee59d; display:flex; align-items:center; gap:7px; }
	.hero-eyebrow i { color:#ffd23f; }
	.hero-title { font-size:1.9rem; font-weight:800; color:#fff; margin:6px 0 6px; }
	.hero-sub { color:#94a3b8; margin:0; max-width:640px; font-size:.9rem; line-height:1.5; }
	.hero-sub strong { color:#cfe9df; }
	.hero-actions { display:flex; gap:10px; flex-wrap:wrap; }
	.hero-btn { border-radius:10px; font-weight:700; font-size:.88rem; padding:10px 18px; border:1px solid transparent; cursor:pointer; display:inline-flex; align-items:center; gap:8px; transition:transform .12s ease, filter .15s ease, background .15s ease; }
	.hero-btn.ghost { background:rgba(148,163,184,.12); border-color:rgba(148,163,184,.28); color:#e2e8f0; }
	.hero-btn.ghost:hover { background:rgba(148,163,184,.2); }
	.hero-btn.solid { background:linear-gradient(135deg,#0DAB76,#2ee59d); color:#04231a; }
	.hero-btn.solid:hover { transform:translateY(-2px); filter:brightness(1.05); }

	/* ===== Layout ===== */
	.tourney-layout { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:20px; align-items:start; }
	.tourney-main { order:1; min-width:0; }
	.create-rail { order:2; }

	/* ===== Panels ===== */
	.tourney-panel { background:rgba(15,23,42,.55); border:1px solid rgba(148,163,184,.14); border-radius:16px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,.28); }

	.pot-section { margin-bottom:20px; }
	.pot-head { display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
	.pot-head-title { font-size:1.15rem; font-weight:800; color:#ffd23f; display:inline-flex; align-items:center; gap:8px; text-shadow:0 1px 6px rgba(245,158,11,.3); }
	.pot-head-sub { color:#eafff7; font-size:.85rem; font-weight:500; text-shadow:0 1px 3px rgba(0,0,0,.4); }

	/* ===== Tabs ===== */
	.t-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
	.t-tab { display:inline-flex; align-items:center; gap:8px; background:rgba(148,163,184,.1); border:1px solid rgba(148,163,184,.18); color:#cbd5e1; padding:9px 15px; border-radius:999px; font-size:.86rem; font-weight:600; cursor:pointer; transition:all .15s ease; }
	.t-tab:hover { background:rgba(148,163,184,.18); border-color:rgba(46,229,157,.5); color:#fff; }
	.t-tab.active { background:linear-gradient(135deg,#0DAB76,#2ee59d); border-color:transparent; color:#04231a; box-shadow:0 5px 16px rgba(13,171,118,.4); }
	.t-tab .t-count { background:rgba(0,0,0,.25); color:inherit; font-size:.72rem; font-weight:800; padding:1px 8px; border-radius:999px; min-width:20px; text-align:center; }
	.t-tab.active .t-count { background:rgba(4,35,26,.22); }
	.dot { width:9px; height:9px; border-radius:50%; display:inline-block; }
	.dot.live { background:#2ee59d; box-shadow:0 0 0 4px rgba(46,229,157,.22); }
	.dot.soon { background:#4aa8ff; }
	.dot.done { background:#94a3b8; }
	.dot.cancel { background:#ef4444; }
	.t-tab-lb i { color:#ffd23f; }
	.t-tab-lb.active i { color:#04231a; }

	.t-panel { display:none; }
	.t-panel.active { display:block; animation:tfade .22s ease; }
	@@keyframes tfade { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }

	.t-empty { text-align:center; color:#cbd5e1; padding:44px 16px; background:rgba(148,163,184,.05); border:1px dashed rgba(148,163,184,.2); border-radius:12px; font-size:.92rem; }
	.t-empty i { display:block; font-size:2rem; margin-bottom:8px; color:rgba(148,163,184,.5); }
	.t-empty.inner { color:#94a3b8; }

	.tourney-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:16px; }

	/* ===== Tournament cards (navy, dashboard-matched) ===== */
	.tc { position:relative; background:#0f172a; border:1px solid rgba(148,163,184,.16); border-top:3px solid #64748b; border-radius:16px; padding:18px; display:flex; flex-direction:column; gap:12px; box-shadow:0 12px 28px rgba(0,0,0,.35); color:#e2e8f0; transition:transform .18s ease, box-shadow .18s ease; overflow:hidden; }
	.tc:hover { transform:translateY(-4px); box-shadow:0 16px 36px rgba(0,0,0,.45); }
	.tc-pot { border-top-color:#f59e0b; background:linear-gradient(160deg,#1a1708 0%,#0f172a 55%); }
	.tc-pot-ribbon { position:absolute; top:12px; right:-34px; transform:rotate(45deg); background:linear-gradient(135deg,#f59e0b,#ffd23f); color:#2a1d00; font-size:.6rem; font-weight:800; letter-spacing:.08em; padding:4px 40px; box-shadow:0 2px 8px rgba(0,0,0,.4); }
	.tc-top { display:flex; justify-content:space-between; align-items:center; }
	.tc-badge { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.8px; padding:4px 10px; border-radius:999px; }
