	.tourney-lb tr.me td { background:rgba(46,229,157,.12); }
	.tourney-lb tbody tr:hover td { background:rgba(46,229,157,.06); }
	.lb-name { color:#e2e8f0; }
	.lb-locked-note { margin-top:12px; }

	/* My bets on navy */
	.mybet-row { background:rgba(148,163,184,.08); border-color:rgba(148,163,184,.14); }
	.mybet-row.clickable:hover { background:rgba(46,229,157,.08); border-color:rgba(46,229,157,.25); }
	.mb-match { color:#e2e8f0; }
	.mb-meta { color:#94a3b8; }

	/* Payout note + board on navy */
	.payout-note { border-top-color:rgba(148,163,184,.18); }
	.pn-title { color:#94a3b8; }
	.pn-chip { background:rgba(148,163,184,.1); border-color:rgba(148,163,184,.16); color:#e2e8f0; }
	.board-msg { background:rgba(148,163,184,.07); border-color:rgba(148,163,184,.12); }
	.board-msg.mine { background:rgba(46,229,157,.08); border-color:rgba(46,229,157,.25); }
	.bmsg-text { color:#e2e8f0; }
	.board-input { background:#0b1220; border:1px solid rgba(148,163,184,.2); color:#e2e8f0; }
	.board-input:focus { background:#0b1220; color:#fff; border-color:#2ee59d; box-shadow:0 0 0 .2rem rgba(46,229,157,.15); }
	.board-input::placeholder { color:#64748b; }
	.info-card { background:rgba(59,130,246,.1); border-color:rgba(59,130,246,.25); color:#93c5fd; }

	/* Rules modal (shared look) */
	.rules-modal { border:none; border-radius:18px; overflow:hidden; background:#0f172a; color:#e2e8f0; box-shadow:0 24px 60px rgba(0,0,0,.5); }
	.rules-modal .modal-header { background:linear-gradient(135deg,#0DAB76,#0a6b4a); color:#fff; border-bottom:none; padding:16px 20px; }
	.rules-modal .modal-title { font-weight:800; display:flex; align-items:center; gap:9px; font-size:1.15rem; }
	.rules-modal .modal-body { padding:18px 20px; }
	.rules-modal .modal-footer { border-top:1px solid rgba(148,163,184,.14); padding:12px 20px; }
	.rules-close { width:34px; height:34px; border-radius:50%; border:none; background:rgba(255,255,255,.18); color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; padding:0; transition:all .12s ease; }
	.rules-close:hover { background:rgba(255,255,255,.32); transform:rotate(90deg); }
	.rule-block { display:flex; gap:14px; padding:12px 0; border-bottom:1px solid rgba(148,163,184,.1); }
