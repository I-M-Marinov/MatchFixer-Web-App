	.rule-icon { flex:0 0 42px; width:42px; height:42px; border-radius:12px; background:rgba(46,229,157,.12); color:#2ee59d; display:flex; align-items:center; justify-content:center; font-size:1.2rem; }
	.rule-block h6 { margin:2px 0 4px; color:#fff; font-weight:800; font-size:.98rem; }
	.rule-block p { margin:0; color:#94a3b8; font-size:.88rem; line-height:1.5; }
	.rule-block strong { color:#cfe9df; }

	/* ===== Black text-shadows to make text pop ===== */
	.back-link, .rules-btn, .detail-desc, .detail-dates, .dh-host,
	.section-h, .ps-val, .ps-label, .bankroll-val, .bankroll-label, .bankroll-rank,
	.chips, .lb-name, .mb-match, .mb-meta, .bmsg-text, .pn-chip, .tc-badge,
	.parlay-chip, .pot-chip { text-shadow:0 1px 2px rgba(0,0,0,.5); }
	.detail-title { text-shadow:0 2px 5px rgba(0,0,0,.55); }
</style>

<script>
	(function () {
		var panel = document.getElementById('slipPanel');
		if (!panel) return;

		var minLegs = parseInt(panel.dataset.minLegs || '1', 10);
		var bankroll = parseFloat(panel.dataset.bankroll || '0');
		var form = document.getElementById('parlayForm');
		var inputsBox = document.getElementById('parlayInputs');
		var legsBox = document.getElementById('slipLegs');
		var countEl = document.getElementById('slipCount');
		var oddsEl = document.getElementById('slipOdds');
		var stakeEl = document.getElementById('slipStake');
		var returnEl = document.getElementById('slipReturn');
		var submitEl = document.getElementById('slipSubmit');
		var hintEl = document.getElementById('slipHint');
		var clearEl = document.getElementById('slipClear');

		var sel = new Map();

		function emptyText() {
			return 'Tap odds on the matches to build your ' + (minLegs > 1 ? (minLegs + '+ leg parlay') : 'bet') + '.';
		}

		function render() {
			legsBox.innerHTML = '';
			if (sel.size === 0) {
				var e = document.createElement('div');
				e.className = 'slip-empty';
				e.textContent = emptyText();
				legsBox.appendChild(e);
			} else {
				sel.forEach(function (v, k) {
					var row = document.createElement('div');
					row.className = 'slip-leg';
					var main = document.createElement('div');
					main.className = 'sl-main';
					var mn = document.createElement('span'); mn.className = 'sl-match'; mn.textContent = v.matchName;
					var pk = document.createElement('span'); pk.className = 'sl-pick'; pk.textContent = v.label + ' @@ ' + v.odds.toFixed(2);
					main.appendChild(mn); main.appendChild(pk);
					var x = document.createElement('button');
					x.type = 'button'; x.className = 'sl-remove'; x.innerHTML = '&times;';
					x.addEventListener('click', function () { removeSel(k); });
					row.appendChild(main); row.appendChild(x);
					legsBox.appendChild(row);
				});
			}

			var combined = 1; sel.forEach(function (v) { combined *= v.odds; });
			countEl.textContent = sel.size;
			oddsEl.textContent = sel.size ? combined.toFixed(2) : '—';
			var stake = parseFloat(stakeEl.value || '0');
			returnEl.textContent = (sel.size && stake > 0) ? (stake * combined).toFixed(2) : '—';

			var ok = true, hint = '';
			if (sel.size < minLegs) {
				ok = false;
				hint = minLegs > 1
					? ('Add ' + (minLegs - sel.size) + ' more leg' + ((minLegs - sel.size) > 1 ? 's' : '') + ' (minimum ' + minLegs + ').')
					: 'Pick at least one match.';
			} else if (!(stake >= 1)) {
				ok = false; hint = 'Enter a stake of at least 1 chip.';
			} else if (stake > bankroll) {
				ok = false; hint = 'Stake exceeds your bankroll (' + bankroll + ' chips).';
			}
			submitEl.disabled = !ok;
			hintEl.textContent = hint;
		}

		function removeSel(matchId) {
			var v = sel.get(matchId);
			if (v && v.btn) v.btn.classList.remove('picked');
			sel.delete(matchId);
			render();
		}

		function onPick(btn) {
			var card = btn.closest('.tbet-card');
			var matchId = card.dataset.matchId;
			var matchName = card.dataset.matchName;
			var pick = btn.dataset.pick;
			var odds = parseFloat(btn.dataset.odds);
			if (isNaN(odds)) return;

			var existing = sel.get(matchId);
			card.querySelectorAll('.tbet-odd').forEach(function (b) { b.classList.remove('picked'); });

			if (existing && existing.pick === pick) {
				sel.delete(matchId);
			} else {
				sel.set(matchId, { pick: pick, odds: odds, label: btn.dataset.label, matchName: matchName, btn: btn });
				btn.classList.add('picked');
			}
			render();
		}

		document.querySelectorAll('.tbet-odd').forEach(function (btn) {
			if (btn.disabled) return;
			btn.addEventListener('click', function () { onPick(btn); });
		});

		stakeEl.addEventListener('input', render);
		clearEl.addEventListener('click', function () {
			sel.forEach(function (v) { if (v.btn) v.btn.classList.remove('picked'); });
			sel.clear(); render();
		});

		form.addEventListener('submit', function (e) {
			if (sel.size < minLegs || submitEl.disabled) { e.preventDefault(); return; }
			inputsBox.innerHTML = '';
			sel.forEach(function (v, k) {
				var mi = document.createElement('input'); mi.type = 'hidden'; mi.name = 'matchIds'; mi.value = k; inputsBox.appendChild(mi);
				var pkk = document.createElement('input'); pkk.type = 'hidden'; pkk.name = 'picks'; pkk.value = v.pick; inputsBox.appendChild(pkk);
			});
		});

		render();
	})();
</script>

<script>
	(function () {
		var rows = document.querySelectorAll('.mybet-row.clickable');
		if (!rows.length) return;

		var modalEl = document.getElementById('betLegsModal');
		var titleEl = document.getElementById('betLegsTitle');
		var sumEl = document.getElementById('betLegsSummary');
		var bodyEl = document.getElementById('betLegsBody');

		function badgeClass(st) {
			if (st === 'Won') return 'b-won';
			if (st === 'Lost') return 'b-lost';
			if (st === 'Voided') return 'b-void';
			return 'b-pending';
		}
		function gradClass(comp, league) {
			var c = (comp || '').toLowerCase();
			if (c) {
				if (c.indexOf('champions') >= 0) return 'grad-cl';
				if (c.indexOf('conference') >= 0) return 'grad-ecl';
				if (c.indexOf('europa') >= 0) return 'grad-el';
				if (c.indexOf('world cup') >= 0) return 'grad-wc';
				if (c.indexOf('euro') >= 0) return 'grad-euro';
				return 'grad-comp';
			}
			var l = (league || '').toLowerCase();
			if (l.indexOf('premier') >= 0) return 'grad-epl';
			if (l.indexOf('liga') >= 0) return 'grad-laliga';
			if (l.indexOf('bundes') >= 0) return 'grad-bundes';
			if (l.indexOf('serie') >= 0) return 'grad-seriea';
			if (l.indexOf('ligue') >= 0) return 'grad-ligue';
			return 'grad-default';
		}
		function esc(s) {
			return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
				return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
			});
		}

		function open(row) {
			var title = row.dataset.title || 'Bet details';
			var status = row.dataset.status || '';
			var odds = row.dataset.odds || '';
			var stake = row.dataset.stake || '';
			var placed = row.dataset.placed || '';
			var win = row.dataset.win || '';
			var potential = row.dataset.potential || '';
			var legs = [];
			try { legs = JSON.parse(row.dataset.legs || '[]'); } catch (e) { legs = []; }

			titleEl.innerHTML = '<i class="bi bi-receipt"></i> ' + esc(title);

			var settled = (status === 'Won' || status === 'Lost' || status === 'Voided');
			var resultCell = settled
				? ('<span class="blm-badge ' + badgeClass(status) + '">' + esc(status + win) + '</span>')
				: ('<span class="blm-badge b-pending">Pending</span>');

			sumEl.innerHTML =
				'<div class="blm-sumrow"><span>Stake</span><span>' + esc(stake) + ' chips</span></div>' +
				'<div class="blm-sumrow"><span>Combined odds</span><span class="blm-odds">' + esc(odds) + '</span></div>' +
				(settled ? '' : '<div class="blm-sumrow"><span>Potential return</span><span>' + esc(potential) + ' chips</span></div>') +
				'<div class="blm-sumrow"><span>Placed</span><span>' + esc(placed) + '</span></div>' +
				'<div class="blm-sumrow"><span>Result</span><span>' + resultCell + '</span></div>';

			var html = '';
			legs.forEach(function (l) {
				html += '<div class="blm-leg ' + gradClass(l.CompetitionName, l.LeagueName) + '">' +
					'<img src="' + esc(l.HomeLogo) + '" class="blm-logo" alt=""/>' +
					'<span class="blm-team">' + esc(l.HomeTeam) + '</span>' +
					'<span class="blm-vs">v</span>' +
					'<span class="blm-team blm-team-away">' + esc(l.AwayTeam) + '</span>' +
					'<img src="' + esc(l.AwayLogo) + '" class="blm-logo" alt=""/>' +
					'<span class="blm-pick">' + esc(l.Pick) + ' @@ ' + Number(l.Odds).toFixed(2) + '</span>' +
					'<span class="blm-legbadge ' + badgeClass(l.Status) + '">' + esc(l.Status) + '</span>' +
					'</div>';
			});
			bodyEl.innerHTML = html;

			if (window.bootstrap && bootstrap.Modal) {
				bootstrap.Modal.getOrCreateInstance(modalEl).show();
			}
		}

		rows.forEach(function (row) {
			row.addEventListener('click', function () { open(row); });
			row.addEventListener('keydown', function (e) {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(row); }
			});
		});
	})();
</script>
