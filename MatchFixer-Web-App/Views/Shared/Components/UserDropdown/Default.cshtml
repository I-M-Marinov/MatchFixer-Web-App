@using MatchFixer.Core.ViewModels.Profile;
@model UserDropdownViewModel

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@inject MatchFixer.Core.Contracts.IEmailQueueService EmailQueue
@inject MatchFixer.Core.Contracts.IChangeRequestService ChangeRequests
<meta name="csrf-token" content="@antiforgery.GetAndStoreTokens(Context).RequestToken" />


@{
	var isAdmin = User.IsInRole(MatchFixer.Common.Identity.Roles.Admin);
	int pendingEmails = 0;
	int pendingChanges = 0;
	if (isAdmin)
	{
		try { pendingEmails = await EmailQueue.GetPendingCountAsync(); } catch { }
		try { pendingChanges = await ChangeRequests.GetPendingCountAsync(); } catch { }
	}
	var pendingTotal = pendingEmails + pendingChanges;
}

<ul class="profile-dropdown-menu d-flex align-items-center">
	@if (User.Identity.IsAuthenticated)
	{
		<li id="betSlipButtonContainer" class="nav-item position-relative">
			<button id="betSlipToggle" class="btn position-relative">
				<img src="/images/bet-slip/bets.png" alt="Bet Slip" style="height: 40px;">
				<span id="betCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
					0
				</span>
			</button>
		</li>
	}
	<li class="nav-item dropdown pe-3 position-relative hover-dropdown-container">

		<a class="nav-link nav-profile d-flex align-items-center pe-0 hover-dropdown" href="#" role="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
			<span class="position-relative d-inline-block">
				<img src="@Model.ProfileImageUrl" alt="User Image" class="rounded-circle">
				@if (isAdmin)
				{
					<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
					      data-review-total
					      style="background-color:#bfe030;color:#1b3b16;font-size:.6rem;font-weight:600;padding:.18em .4em;line-height:1;border:1px solid rgba(0,0,0,.25);@(pendingTotal > 0 ? "" : "display:none;")"
					      title="@pendingTotal item(s) awaiting review">@pendingTotal</span>
				}
			</span>
			<span class="d-none d-md-block dropdown ps-2"></span>
		</a>

		<ul class="dropdown-menu dropdown-menu-end profile">

			<li class="dropdown-header">
				<h6 class="d-flex align-items-center justify-content-center">@Model.FullName</h6>
			</li>
			<li>
				<hr class="dropdown-divider">
			</li>

			@if (isAdmin)
			{
				<li>

					<form method="get" asp-area="Admin" asp-controller="EmailQueue" asp-action="Index">
						<button type="submit" class="dropdown-item d-flex  align-items-center justify-content-center">
							<span>
								<i class="bi bi-clipboard-check-fill" style="color:#ffc43d;"></i> Review Center
								<span class="badge rounded-pill bg-danger ms-1" data-review-total style="@(pendingTotal > 0 ? "" : "display:none;")">@pendingTotal</span>
							</span>
						</button>
					</form>
				</li>
				<li>
					<hr class="dropdown-divider">
				</li>
			}

			<li>

				<form method="get" asp-area="" asp-controller="Profile" asp-action="Profile">
					<input type="hidden" name="userId" value="@Model.Id"/>
					<button type="submit" class="dropdown-item d-flex  align-items-center justify-content-center">
						<span><i class="bi bi-person"></i> My Profile</span>
					</button>
				</form>
			</li>
			<li>
				<hr class="dropdown-divider">
			</li>
			
			<li>
				
				<form method="get" asp-area="" asp-controller="UserBets" asp-action="UserBets">
					<input type="hidden" name="userId" value="@Model.Id" />
					<button type="submit" class="dropdown-item d-flex  align-items-center justify-content-center">
						<span><i class="ri-file-list-fill"></i> My BetSlips</span>
					</button>
				</form>
			</li>

			<li>
				<hr class="dropdown-divider">
			</li>
			
			<li>

				<form method="get" asp-area="" asp-controller="Wallet" asp-action="WalletDetails">
					<button type="submit" class="dropdown-item d-flex  align-items-center justify-content-center">
						<span><i class="bi bi-wallet2"></i> My Wallet</span>
					</button>
				</form>
			</li>

			<li>
				<hr class="dropdown-divider">
			</li>

			<li>
				<form method="get" asp-area="" asp-controller="Home" asp-action="Privacy">
					<button type="submit" class="dropdown-item d-flex align-items-center justify-content-center">
						<span><i class="bi bi-info-circle"></i> Privacy Policy</span>
					</button>
				</form>
			</li>
			<li>
				<hr class="dropdown-divider">
			</li>

			<li>
				<form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
					<button type="submit" class="dropdown-item d-flex align-items-center justify-content-center">

						<span><i class="bi bi-box-arrow-right"></i> Sign Out</span>
					</button>
				</form>
			</li>



		</ul><!-- End Profile Dropdown Items -->
	</li><!-- End Profile Nav -->
</ul>

@if (isAdmin && User.Identity?.IsAuthenticated == true)
{
	@* Live Review Center updates *@
	<span hidden data-review-live data-pending-emails="@pendingEmails" data-pending-changes="@pendingChanges"></span>
	<style>
		.review-toast-host { position: fixed; right: 18px; bottom: 18px; z-index: 2000; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
		.review-toast { pointer-events: auto; display: flex; align-items: flex-start; gap: 10px; width: 320px; max-width: calc(100vw - 36px); padding: 12px 14px; border-radius: 12px; background: #1d2125; color: #e9ecef; text-decoration: none; box-shadow: 0 10px 30px rgba(0,0,0,.35); border-left: 4px solid #bfe030; opacity: 0; transform: translateY(10px); transition: opacity .25s ease, transform .25s ease; font-size: 13px; line-height: 1.35; }
		.review-toast.show { opacity: 1; transform: translateY(0); }
		.review-toast:hover { color: #fff; background: #23282d; }
		.review-toast-icon { font-size: 1.2rem; color: #bfe030; margin-top: 1px; }
		.review-toast-title { font-weight: 700; margin-bottom: 2px; }
		.review-toast-text { color: rgba(233,236,239,.75); word-break: break-word; }
		.review-pulse { animation: reviewPulse .9s ease 2; }
		@@keyframes reviewPulse { 0%,100% { transform: translate(-50%,-50%) scale(1); } 50% { transform: translate(-50%,-50%) scale(1.35); } }
		.dropdown-item .review-pulse { animation-name: reviewPulseInline; }
		@@keyframes reviewPulseInline { 0%,100% { transform: scale(1); } 50% { transform: scale(1.3); } }
		.cr-card-new { animation: crCardIn .45s ease; box-shadow: 0 0 0 2px rgba(191,224,48,.65); }
		.cr-card-leaving { opacity: 0; transform: translateX(12px); transition: opacity .25s ease, transform .25s ease; }
		@@keyframes crCardIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
	</style>
	<script src="~/js/admin-review-live.js" asp-append-version="true" defer></script>
}

