@using MatchFixer.Core.ViewModels.MatchGuessGame;
@model List<LeaderboardEntryViewModel>


@{
    ViewData["Title"] = "MatchFix Guess Game";
}

<style>
	html, body {
		overflow-y: hidden; 
		overflow-x: hidden; 
	}
</style>


<div class="game-background"></div>

<div class="football-pitch">
	<img style="max-width: 100%; max-height: 100%; object-fit: cover; z-index: -1; position:relative;" src="/images/football-pitch/football-pitch1.png" title="Germany's Bundesliga" />
</div>

<!-- Rules Modal -->
<div class="modal fade" id="rulesModal" tabindex="-1" aria-labelledby="rulesModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content" style="background: rgba(0,0,0,0.92); border-radius: 14px; border: 1px solid rgba(255,215,0,0.25); color: #f0f0f0;">
			<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="position:absolute; top:14px; right:16px; z-index:10; outline:none; box-shadow:none;"></button>
			<div class="modal-header border-0 d-flex flex-column justify-content-center align-items-center pb-1">
				<h4 class="modal-title" id="rulesModalLabel" style="font-size:0.95rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:#ffd700;">
					⚽ Rules
				</h4>
			</div>
			<div class="modal-body pt-1" style="font-size:0.82rem;">
				<div style="display:flex; flex-direction:column; gap:10px;">

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">🎯</span>
						<span>Guess the actual result of <span style="background:rgba(59,130,246,0.2); border:1px solid #3b82f6; border-radius:6px; padding:1px 8px; font-weight:700;">10</span> football matches.</span>
					</div>

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">🏆</span>
						<span>Matches are from the <strong style="color:#ffd700;">2023/24 Season</strong> — Premier League, La Liga, Bundesliga and Serie A.</span>
					</div>

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">⏱️</span>
						<span>You have <span style="background:rgba(248,113,113,0.2); border:1px solid #f87171; border-radius:6px; padding:1px 8px; font-weight:700;">15s</span> per match to guess the actual result.</span>
					</div>

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">🎯</span>
						<span>You must guess the correct score for <strong>both</strong> teams — partial scores score nothing.</span>
					</div>

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">✅</span>
						<span>Each correct guess earns <span style="background:rgba(74,222,128,0.15); border:1px solid #4ade80; border-radius:6px; padding:1px 8px; font-weight:700;">+10 pts</span>.</span>
					</div>

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">⚡</span>
						<div>
							<strong style="color:#facc15;">Derby matches</strong> are worth <span style="background:rgba(250,204,21,0.15); border:1px solid #facc15; border-radius:6px; padding:1px 8px; font-weight:700;">×2</span> — either
							<span style="background:rgba(74,222,128,0.15); border:1px solid #4ade80; border-radius:6px; padding:1px 6px; font-weight:700;">10</span> or
							<span style="background:rgba(74,222,128,0.15); border:1px solid #4ade80; border-radius:6px; padding:1px 6px; font-weight:700;">20</span> points.
						</div>
					</div>

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">🚀</span>
						<div>
							Get at least <span style="background:rgba(59,130,246,0.2); border:1px solid #3b82f6; border-radius:6px; padding:1px 8px; font-weight:700;">5</span> out of <span style="background:rgba(59,130,246,0.2); border:1px solid #3b82f6; border-radius:6px; padding:1px 8px; font-weight:700;">10</span> correct
							and your score gets doubled:
							<span style="background:rgba(74,222,128,0.15); border:1px solid #4ade80; border-radius:6px; padding:1px 6px; font-weight:700;">50</span> →
							<span style="background:rgba(74,222,128,0.15); border:1px solid #4ade80; border-radius:6px; padding:1px 6px; font-weight:700;">100</span>.
						</div>
					</div>

					<div style="display:flex; align-items:flex-start; gap:10px; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:8px;">
						<span style="font-size:1rem; flex-shrink:0;">⭐</span>
						<span>Once doubled, every correct guess earns <span style="background:rgba(74,222,128,0.15); border:1px solid #4ade80; border-radius:6px; padding:1px 8px; font-weight:700;">+20 pts</span>.</span>
					</div>

					<div style="text-align:center; padding-top:4px; font-weight:700; color:#ffd700; letter-spacing:0.03em;">
						Last but not least — HAVE FUN AT ALL TIMES! 🎉
					</div>

				</div>
			</div>
		</div>
	</div>
</div>


<!-- Main Screen -->
<div class="container py-5 text-center d-flex flex-column justify-content-center align-items-center" style="padding: 0.8em; max-width:1200px;">
	<h1 id="welcome-to-matchfix" class="mb-4 animate__animated animate__zoomIn">⚽ Welcome to the MatchFix Game! ⚽</h1>
	
	<!-- League Logos  -->
	<div class="mb-2" style="padding: 0.8em; border-radius: 0.5em; max-width: 700px;">
		<div>
			<ul class="d-flex justify-content-center gap-5 mb-2">
				<li>
					<img class="animate__animated animate__fadeInUp animate__slower" style="width: 75px; height: auto; object-fit: cover;" src="https://media.api-sports.io/football/leagues/39.png" title="England's Premier League" />
				</li>
				<li>
					<img class="animate__animated animate__fadeInUp animate__slower" style="width: 75px; height: auto; object-fit: cover;" src="https://media.api-sports.io/football/leagues/140.png" title="Spain's LaLiga" />
				</li>
				<li>
					<img class="animate__animated animate__fadeInUp animate__slower" style="width: 75px; height: auto; object-fit: cover;" src="https://media.api-sports.io/football/leagues/78.png" title="Germany's Bundesliga" />
				</li>
				<li>
					<img class="animate__animated animate__fadeInUp animate__slower" style="width: 75px; height: auto; object-fit: cover;" src="https://media.api-sports.io/football/leagues/135.png" title="Italy's SeriaA" />
				</li>
			</ul>
		</div>
		<p class="animate__animated animate__backInUp animate__slower" id="season">2023/24 Season</p>
	</div>

	<div class="mt-4 d-flex gap-5 justify-content-center">
		<div class="scale-button-wrapper">
			<a href="@Url.Action("Start", "Game")"
			   id="start-game-btn"
			   class="btn btn-success btn-lg px-5 py-3 rounded-pill animate__animated animate__zoomIn animate__slower scale-hover">
				Start Game
			</a>
		</div>
	</div>
	
	<div class="mt-5 d-flex gap-3 justify-content-center">

		<div class="scale-button-wrapper">
			<button type="button"
			        id="rules-btn"
			        class="btn btn-info btn-lg px-4 py-3 rounded-pill animate__animated animate__zoomIn animate__slower scale-hover"
			        data-bs-toggle="modal"
			        data-bs-target="#rulesModal">
				Rules
			</button>
		</div>

		<div class="scale-button-wrapper">
			<a href="@Url.Action("Leaderboard", "Game")"
			   id="leaderboard-btn"
			   class="btn btn-success btn-lg px-5 py-3 rounded-pill animate__animated animate__zoomIn animate__slower scale-hover">
				Leaderboard
			</a>
		</div>
	</div>
</div>

