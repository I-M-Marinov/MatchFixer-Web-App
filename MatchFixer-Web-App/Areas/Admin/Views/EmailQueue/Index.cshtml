@using MatchFixer.Common.Enums
@using MatchFixer.Infrastructure.Entities
@model MatchFixer_Web_App.Areas.Admin.ViewModels.Email.ReviewCenterViewModel
@{
    Layout = "/Areas/Admin/Views/Shared/_Layout.Admin.cshtml";
    ViewData["Title"] = "Review Center";

    var sections = new (string Title, string Icon, IReadOnlyList<QueuedEmail> Items)[]
    {
        ("Winning emails", "bi-trophy-fill", Model.Winning),
        ("Other emails", "bi-envelope-paper-fill", Model.Other)
    };

    var approvalsActive = Context.Request.Query["tab"] == "approvals";
}

@functions {
    string StatusClass(EmailQueueStatus st) => st switch
    {
        EmailQueueStatus.Pending  => "bg-warning text-dark",
        EmailQueueStatus.Approved => "bg-info text-dark",
        EmailQueueStatus.Failed   => "bg-danger",
        EmailQueueStatus.Sent     => "bg-success",
        _                         => "bg-secondary"
    };
}

<div class="admin-users-background"></div>

<div class="email-qa-wrapper">

    @if (TempData["SuccessMessage"] is string sm)
    {
        <div class="alert success-message">@sm</div>
    }
    @if (TempData["ErrorMessage"] is string em)
    {
        <div class="alert error-message">@em</div>
    }

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h2 class="email-qa-title m-0"><i class="bi bi-clipboard-check-fill me-2"></i>Review Center</h2>
        <a class="btn btn-ocean btn-sm" asp-area="Admin" asp-controller="Users" asp-action="ShowUsers">
            <i class="bi bi-arrow-left"></i> Back to users
        </a>
    </div>

<style>
    .review-tabs { list-style:none; display:flex; gap:8px; padding:0; margin:0 0 1rem; flex-wrap:wrap; }
    .review-tab { background:rgba(148,163,184,.12); border:1px solid rgba(148,163,184,.25); color:#e2e8f0; border-radius:10px; padding:8px 16px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:8px; }
    .review-tab.active { background:linear-gradient(135deg,#3b82f6,#2563eb); color:#fff; border-color:transparent; box-shadow:0 4px 14px rgba(37,99,235,.4); }
    .review-tab-badge { background:rgba(0,0,0,.25); color:inherit; border-radius:999px; font-size:.72rem; padding:1px 8px; font-weight:800; }
    .cr-card .cr-email { color:#94a3b8; font-size:.82rem; margin-left:.4rem; }
    .cr-form { display:flex; gap:10px; align-items:center; margin-top:10px; flex-wrap:wrap; }
    .cr-note { flex:1 1 220px; min-width:180px; }
    .cr-actions { display:flex; gap:8px; }
    .qa-interval-label { color:#fff !important; font-weight:600; margin-bottom:0; }
    select.qa-interval-select.form-select, select#qa-interval { width:auto !important; min-width:9rem; background-color:#0b2740 !important; color:#fff !important; border:1px solid rgba(255,255,255,.25) !important; border-radius:.5rem !important; font-weight:600 !important; background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23ffffff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important; }
    select.qa-interval-select.form-select:focus, select#qa-interval:focus { background-color:#0b2740 !important; color:#fff !important; border-color:#3370a8 !important; box-shadow:0 0 0 .2rem rgba(51,112,168,.35) !important; }
    select.qa-interval-select.form-select option, select#qa-interval option { color:#0f172a !important; background-color:#fff !important; font-weight:600; }
</style>

    <ul class="review-tabs" role="tablist">
        <li><button type="button" class="review-tab @(approvalsActive ? "" : "active")" data-bs-toggle="tab" data-bs-target="#tab-emails"><i class="bi bi-envelope-paper-fill"></i> Emails <span class="review-tab-badge">@Model.PendingCount</span></button></li>
        <li><button type="button" class="review-tab @(approvalsActive ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-approvals"><i class="bi bi-person-check-fill"></i> Approvals <span class="review-tab-badge" id="approvalsTabBadge">@Model.ChangeRequestsPendingCount</span></button></li>
    </ul>

    <div class="tab-content">
    <div class="tab-pane fade @(approvalsActive ? "" : "show active")" id="tab-emails" role="tabpanel">

    <form id="qa-form" method="post" asp-area="Admin" asp-controller="EmailQueue" asp-action="SendNow">
        @Html.AntiForgeryToken()

        <!-- TOOLBAR -->
        <div class="email-qa-toolbar d-flex flex-wrap align-items-center gap-2 mb-4">
            <button type="submit" class="btn btn-mint btn-sm" formaction="/Admin/EmailQueue/SendNow">
                <i class="bi bi-send-fill"></i> Send now
            </button>

            <div class="d-flex align-items-center gap-2 ms-2">
                <label class="mb-0 qa-interval-label" for="qa-interval">Interval:</label>
                <select id="qa-interval" name="intervalSeconds" class="form-select form-select-sm qa-interval-select">
                    <option value="0">No gap</option>
                    <option value="15">15 seconds</option>
                    <option value="30" selected>30 seconds</option>
                    <option value="60">1 minute</option>
                    <option value="120">2 minutes</option>
                    <option value="300">5 minutes</option>
                </select>
            </div>

            <button type="submit" class="btn btn-ocean btn-sm" formaction="/Admin/EmailQueue/Schedule">
                <i class="bi bi-clock-history"></i> Send with interval
            </button>

            <button type="submit" class="btn btn-outline-light btn-sm ms-auto qa-drop-btn"
                    formaction="/Admin/EmailQueue/Drop"
                    onclick="return confirm('Drop the selected emails? They will not be sent.');">
                <i class="bi bi-trash"></i> Drop selected
            </button>
        </div>

        @foreach (var sec in sections)
        {
            <div class="email-qa-section mb-4">
                <h5 class="email-qa-section-title d-flex align-items-center flex-wrap gap-2">
                    <span><i class="bi @sec.Icon me-2"></i>@sec.Title</span>
                    <span class="badge rounded-pill qa-count-badge">@sec.Items.Count</span>
                    @if (sec.Items.Count > 0)
                    {
                        <button type="button" class="btn btn-ocean btn-sm qa-section-selectall ms-auto">
                            <i class="bi bi-check2-square"></i> <span class="qa-selectall-text">Select all</span>
                        </button>
                    }
                </h5>

                @if (sec.Items.Count == 0)
                {
                    <div class="qa-empty">No emails in this section.</div>
                }
                else
                {
                    <div class="qa-card-list">
                        @foreach (var e in sec.Items)
                        {
                            <div class="qa-card">
                                <div class="qa-card-head">
                                    <input class="form-check-input qa-check" type="checkbox" name="ids" value="@e.Id" />
                                    <div class="qa-card-main">
                                        <div class="qa-card-recipient"><i class="bi bi-person-fill me-1"></i>@e.Recipient</div>
                                        <div class="qa-card-subject">@e.Subject</div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(e.RelatedInfo))
                                {
                                    <div class="qa-card-context">
                                        <span class="qa-card-label">Context</span> @e.RelatedInfo
                                    </div>
                                }

                                <div class="qa-card-foot">
                                    <span class="badge @StatusClass(e.Status)">@e.Status</span>
                                    <span class="qa-card-date"><i class="bi bi-clock me-1"></i>@e.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</span>
                                    <button type="button" class="btn btn-ocean btn-sm qa-view-btn ms-auto" data-id="@e.Id">
                                        <i class="bi bi-eye"></i> View / edit
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </form>

    </div><!-- /tab-emails -->

    <div class="tab-pane fade @(approvalsActive ? "show active" : "")" id="tab-approvals" role="tabpanel">
        <div class="qa-empty" id="approvalsEmpty" style="@(Model.ChangeRequests.Any() ? "display:none;" : "")">No change requests awaiting approval.</div>
        <div class="qa-card-list" id="approvalsList" style="@(Model.ChangeRequests.Any() ? "" : "display:none;")">
                @foreach (var r in Model.ChangeRequests)
                {
                    <div class="qa-card cr-card" data-request-id="@r.Id">
                        <div class="qa-card-main">
                            <div class="qa-card-recipient"><i class="bi bi-person-fill me-1"></i>@r.UserName<span class="cr-email">@r.UserEmail</span></div>
                            <div class="qa-card-subject"><span class="badge bg-info text-dark me-1">@r.TypeLabel</span> @r.Summary</div>
                        </div>
                        <div class="qa-card-foot">
                            <span class="qa-card-date"><i class="bi bi-clock me-1"></i>@r.RequestedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</span>
                        </div>
                        <form method="post" asp-area="Admin" asp-controller="ChangeRequest" asp-action="Approve" class="cr-form">
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="text" name="note" maxlength="1000" class="form-control form-control-sm cr-note" placeholder="Optional note (kept in the log)" />
                            <div class="cr-actions">
                                <button type="submit" class="btn btn-mint btn-sm" formaction="/Admin/ChangeRequest/Approve"><i class="bi bi-check2-circle"></i> Approve</button>
                                <button type="submit" class="btn btn-outline-danger btn-sm" formaction="/Admin/ChangeRequest/Reject" onclick="return confirm('Reject this request?');"><i class="bi bi-x-octagon"></i> Reject</button>
                            </div>
                        </form>
                    </div>
                }
        </div>
    </div><!-- /tab-approvals -->
    </div><!-- /tab-content -->
</div>

<!-- VIEW / EDIT MODAL -->
<div class="modal fade" id="emailViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable qa-modal-wide">
        <div class="modal-content email-qa-modal">
            <form method="post" asp-area="Admin" asp-controller="EmailQueue" asp-action="Update">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit-id" />

                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Review email <small class="ms-2 opacity-75" id="edit-recipient"></small></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="edit-subject">Subject</label>
                        <input type="text" class="form-control" name="subject" id="edit-subject" maxlength="300" />
                    </div>

                    <div class="accordion qa-accordion" id="qaEditorAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#qaBodyPane" aria-expanded="true" aria-controls="qaBodyPane">
                                    <i class="bi bi-code-slash me-2"></i> Body (HTML)
                                </button>
                            </h2>
                            <div id="qaBodyPane" class="accordion-collapse collapse show" data-bs-parent="#qaEditorAccordion">
                                <div class="accordion-body">
                                    <textarea class="form-control qa-body-area" name="bodyHtml" id="edit-body" rows="16"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#qaPreviewPane" aria-expanded="false" aria-controls="qaPreviewPane">
                                    <i class="bi bi-eye me-2"></i> Live preview
                                </button>
                            </h2>
                            <div id="qaPreviewPane" class="accordion-collapse collapse" data-bs-parent="#qaEditorAccordion">
                                <div class="accordion-body">
                                    <iframe id="edit-preview" class="qa-preview" title="Email preview"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-mint"><i class="bi bi-save"></i> Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modalEl = document.getElementById('emailViewModal');
            const bsModal = (window.bootstrap && modalEl) ? new bootstrap.Modal(modalEl) : null;
            const idInput = document.getElementById('edit-id');
            const subjInput = document.getElementById('edit-subject');
            const bodyInput = document.getElementById('edit-body');
            const preview = document.getElementById('edit-preview');
            const recipientLbl = document.getElementById('edit-recipient');

            function refreshPreview() { if (preview) preview.srcdoc = bodyInput.value || ''; }

            document.querySelectorAll('.qa-view-btn').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    const id = btn.getAttribute('data-id');
                    try {
                        const res = await fetch('/Admin/EmailQueue/Get?id=' + encodeURIComponent(id));
                        if (!res.ok) return;
                        const data = await res.json();
                        idInput.value = data.id;
                        subjInput.value = data.subject || '';
                        bodyInput.value = data.bodyHtml || '';
                        if (recipientLbl) recipientLbl.textContent = data.recipient || '';
                        refreshPreview();
                        if (bsModal) bsModal.show();
                    } catch (err) { console.error('Failed to load email', err); }
                });
            });

            if (bodyInput) bodyInput.addEventListener('input', refreshPreview);

            const previewPane = document.getElementById('qaPreviewPane');
            if (previewPane) previewPane.addEventListener('shown.bs.collapse', refreshPreview);

            document.querySelectorAll('.qa-section-selectall').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const section = btn.closest('.email-qa-section');
                    if (!section) return;
                    const checks = section.querySelectorAll('.qa-check');
                    const target = !(checks.length > 0 && Array.prototype.every.call(checks, function (c) { return c.checked; }));
                    checks.forEach(function (c) { c.checked = target; });
                    const txt = btn.querySelector('.qa-selectall-text');
                    if (txt) txt.textContent = target ? 'Deselect all' : 'Select all';
                });
            });
        })();
    </script>
}
