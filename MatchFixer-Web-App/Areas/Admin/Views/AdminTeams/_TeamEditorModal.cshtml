@model MatchFixer_Web_App.Areas.Admin.ViewModels.Teams.TeamEditorVm

<div class="team-editor-wrapper">

    <div class="team-editor-title">
        @Model.Name
    </div>

    <div class="team-editor-layout">

        <!-- LEFT -->
        <div class="team-editor-logo-column">

	        @{
		        string logoStatusText;
		        string logoStatusClass;

		        if (!string.IsNullOrWhiteSpace(Model.LocalLogoUrl) && !Model.LocalLogoFileExists)
		        {
			        logoStatusText = "Local file missing";
			        logoStatusClass = "is-missing";
		        }
		        else if (Model.IsCustomLogo)
		        {
			        logoStatusText = "Custom upload";
			        logoStatusClass = "is-custom";
		        }
		        else if (Model.LocalLogoFileExists)
		        {
			        logoStatusText = "Cached locally";
			        logoStatusClass = "is-cached";
		        }
		        else
		        {
			        logoStatusText = "Remote only";
			        logoStatusClass = "is-remote";
		        }
	        }

	        <div class="team-logo-panel" id="teamLogoPanel" data-team-id="@Model.TeamId">
		        <div class="team-logo-card">
			        <img id="teamLogoPreview"
			             src="@Model.EffectiveLogoUrl"
			             data-fallback="@Model.LogoUrl"
			             alt="@Model.Name"
			             onerror="if(this.dataset.fallback && this.src.indexOf(this.dataset.fallback)===-1){this.src=this.dataset.fallback;}else{this.onerror=null;this.closest('.team-logo-card').classList.add('is-broken');}" />
			        <span class="team-logo-broken-text">No logo</span>
		        </div>

		        <span class="team-logo-status @logoStatusClass" id="teamLogoStatus">@logoStatusText</span>

		        @if (Model.LogoLastSyncedUtc != null)
		        {
			        <span class="team-logo-synced">
				        Updated @Model.LogoLastSyncedUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
			        </span>
		        }

		        <div class="team-logo-actions">
			        <input type="file"
			               id="teamLogoFile"
			               accept="image/png,image/jpeg,image/gif,image/webp"
			               hidden />
			        <button type="button" class="btn btn-sm btn-outline-info team-logo-upload-btn">
				        <i class="bi bi-upload me-1"></i> Upload logo
			        </button>
			        <button type="button" class="btn btn-sm btn-outline-warning team-logo-redownload-btn"
			                title="Download again from the Logo source URL">
				        <i class="bi bi-arrow-repeat me-1"></i> Re-download
			        </button>
		        </div>

		        <div class="team-logo-message" id="teamLogoMessage" role="status"></div>
	        </div>

	        @if (!string.IsNullOrWhiteSpace(Model.WikiImageUrl))
	        {
		        <div class="wiki-logo-card">
			        <img src="@Model.WikiImageUrl"
			             alt="Wikipedia Image"
			             onerror="this.closest('.wiki-logo-card').style.display='none';" />
		        </div>
	        }

        </div>

        <!-- RIGHT -->
        <div class="team-editor-fields">
            <form id="teamEditorForm">
	            @Html.AntiForgeryToken()
                <input type="hidden" name="TeamId" value="@Model.TeamId" />

                <div class="mb-3">
                    <label>Team name</label>
                    <input class="form-control"
                           name="Name"
                           value="@Model.Name" />
                </div>

                <div class="mb-3">
                    <label>API Team ID</label>
                    <input class="form-control"
                           name="ApiTeamId"
                           type="number"
                           value="@Model.ApiTeamId"
                           placeholder="e.g. 855" />
                </div>

                <div class="mb-3">
	                <label>Logo source URL</label>
	                <div class="input-group">
		                <input class="form-control"
		                       name="LogoUrl"
		                       id="teamLogoUrlInput"
		                       type="url"
		                       maxlength="250"
		                       value="@Model.LogoUrl"
		                       placeholder="https://…/logo.png" />
		                <button type="button"
		                        class="btn btn-outline-secondary team-logo-use-api-btn"
		                        title="Fill in the API-Football logo URL for the API Team ID">
			                API URL
		                </button>
	                </div>
	                <small class="text-muted">Changing this and saving downloads the new image. Uploading a file overrides it.</small>
                </div>

                <div class="mb-3">
                    <label>League</label>
                    <select class="form-select" name="LeagueId">
                        @foreach (var l in Model.Leagues)
                        {
                            <option value="@l.Id"
                                    selected="@(l.Id == Model.LeagueId)">
                                @l.Name
                            </option>
                        }
                    </select>
                </div>

	            <div class="team-editor-aliases">
		            <label class="form-label">Aliases</label>

		            <div id="aliasList">
			            @if (Model.Aliases.Any())
			            {
				            @for (var i = 0; i < Model.Aliases.Count; i++)
				            {
					            <div class="team-alias-row">
						            <input class="form-control"
						                   name="Aliases[@i].Alias"
						                   value="@Model.Aliases[i].Alias" />
					            </div>
				            }
			            }
			            else
			            {
				            @if (!Model.Aliases.Any())
				            {
					            <div class="team-alias-row">
						            <input class="form-control"
						                   name="Aliases[0].Alias"
						                   placeholder="Add an alias…" />
					            </div>
				            }
			            }
		            </div>

	            </div>

	            <hr />

	            <h5 class="text-warning mb-2 text-center">
		            Wikipedia Information
	            </h5>

	            <div class="mb-3">
		            <label class="form-label">Wikipedia Summary</label>

		            <textarea class="form-control "rows="4" name="WikiSummary">@Model.WikiSummary</textarea>
	            </div>

	            <div class="mb-3">
		            <label class="form-label">Wikipedia Image</label>

		            <input class="form-control"
		                   name="WikiImageUrl"
		                   value="@Model.WikiImageUrl" />

	            </div>

	            <div class="mb-3">
		            <label class="form-label">Wikipedia URL</label>

		            <input class="form-control"
		                   name="WikipediaUrl"
		                   value="@Model.WikipediaUrl" />
	            </div>

	            @if (Model.WikiLastUpdatedUtc != null)
	            {
		            <div class="d-flex justify-content-center align-items-center">
			            <label class="text-info badge justify-content-center">
				            Last Updated:
				            @Model.WikiLastUpdatedUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
			            </label>
		            </div>
	            }

	            <div class="team-editor-save d-flex justify-content-between align-items-center mt-3">
		            <button type="button" class="btn btn-outline-danger btn-sm delete-team-btn"
		                    data-team-id="@Model.TeamId"
		                    data-team-name="@Model.Name">
			            <i class="bi bi-trash me-1"></i> Delete team
		            </button>
		            <button class="btn btn-primary">Save team</button>
	            </div>
            </form>
        </div>

    </div>

</div>

