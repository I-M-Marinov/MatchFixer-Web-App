# Rename to .env and fill in real values. ":" in a config key becomes "__".

# ---- Database: your existing SQL Server on the NAS ----
ConnectionStrings__DefaultConnection=Server=mssql,1433;Database=MatchFixer;User Id=sa;Password=YOUR_SA_PASSWORD;TrustServerCertificate=True;Encrypt=True

# ---- Football API (api-sports.io) ----
FootballApi__Key=CHANGE_ME

# ---- TheSportsDB API ----
TheSportsDBApi__Key=CHANGE_ME

# ---- Cloudinary ----
CloudinarySettings__CloudName=CHANGE_ME
CloudinarySettings__ApiKey=CHANGE_ME
CloudinarySettings__ApiSecret=CHANGE_ME

# ---- Gmail SMTP ----
GmailSmtp__User=you@gmail.com
GmailSmtp__Pass=CHANGE_ME_app_password

# ---- Seed admin account (created on first run) ----
Admin__Email=CHANGE_ME
Admin__Password=CHANGE_ME
Admin__FirstName=CHANGE_ME
Admin__LastName=CHANGE_ME
Admin__Country=CHANGE_ME
Admin__TimeZone=CHANGE_ME
Admin__DateOfBirth=1990-01-01
